<div class="pcr-card pcr-{{mode}}">
  <header>
    <img src="{{img}}" alt="" width="36" height="36">
    <div class="pcr-head-text">
      <span class="pcr-name">{{name}}{{#if hasValue}} {{value}}{{/if}}</span>
      <span class="pcr-sub">{{kindLabel}} — {{actorName}}</span>
    </div>
    <button type="button" class="pcr-close" data-action="close" title="{{closeLabel}}">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>
  {{#if showDetails}}
  <div class="pcr-body">
    {{#if hint}}
    <p class="pcr-hint"><i class="fa-solid fa-hourglass-half"></i> {{hint}}</p>
    {{/if}}
    {{#if duration}}
    <p class="pcr-duration"><i class="fa-solid fa-clock"></i> {{duration}}</p>
    {{/if}}
    <div class="pcr-desc">{{{description}}}</div>
  </div>
  {{/if}}
</div>
